# IA
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# App
DATABASE_URL=./job_tracker.db
RAW_DATA_PATH=./raw_data

# Docker: carpeta donde la extensión Chrome descarga los JSON de vacantes,
# se monta directamente como raw_data/ dentro del contenedor del backend.
# En WSL con Docker Desktop, la ruta de Windows se ve como /mnt/c/...
RAW_DATA_HOST_PATH=/mnt/c/Users/<TU_USUARIO>/Downloads/JobTracker
