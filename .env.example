# =====================================================================
# RAW_DATA_HOST_PATH
# Carpeta del equipo (host) donde el scraper deja los JSON de vacantes.
# Se monta dentro del contenedor como /app/raw_data (solo lectura).
#
# Convencion del proyecto: usar la carpeta "JobTracker" dentro de Descargas.
# Escribe la ruta segun tu sistema operativo y descomenta UNA sola linea:
#
#   Windows (Docker Desktop, PowerShell/CMD/Git Bash)
#     Usa barras normales "/" aunque sea Windows. Docker Desktop las traduce.
#     RAW_DATA_HOST_PATH=C:/Users/TU_USUARIO/Downloads/JobTracker
#
#   WSL (Docker corriendo dentro de WSL)
#     RAW_DATA_HOST_PATH=/mnt/c/Users/TU_USUARIO/Downloads/JobTracker
#
#   macOS
#     RAW_DATA_HOST_PATH=/Users/TU_USUARIO/Downloads/JobTracker
#
#   Linux
#     RAW_DATA_HOST_PATH=/home/TU_USUARIO/Downloads/JobTracker
#
# Si dejas la linea comentada, se usa ./raw_data dentro del repo.
# =====================================================================
RAW_DATA_HOST_PATH=./raw_data

# Solo para ejecucion fuera de Docker (backend/run.py).
DATABASE_URL=./job_tracker.db
RAW_DATA_PATH=./raw_data
FILTRADAS_PATH=./filtradas/filtradas.json
