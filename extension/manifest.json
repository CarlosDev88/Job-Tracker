{
    "manifest_version": 3,
    "name": "Job Tracker — LinkedIn Scraper",
    "version": "1.0.0",
    "description": "Extrae ofertas de LinkedIn y las guarda como JSON para el pipeline local.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "downloads"
    ],
    "host_permissions": [
        "https://www.linkedin.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    }
}